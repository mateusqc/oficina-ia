      "parameters": {
        "promptType": "define",
        "text": "={{ 'Classifique o email abaixo. Use somente um destes tipos: envio_xml, duvida_fiscal, cobranca, pendencia_documental, solicitacao_folha. Retorne exatamente este formato: {\"tipo\":\"\",\"cliente\":\"\",\"competencia\":\"\",\"urgencia\":\"\",\"acao\":\"\"}. Regras: urgencia deve ser baixa, normal ou alta; competencia deve ser AAAA-MM quando aparecer no texto, senao vazio; acao deve ser curta e operacional. Email: cliente=' + ($json.body?.cliente || 'Cliente nao informado') + '; assunto=' + ($json.body?.assunto || '') + '; corpo=' + ($json.body?.corpo || '') }}",
        "options": {
          "systemMessage": "Voce e um assistente de triagem de emails para um escritorio contabil. Sua tarefa e classificar a intencao do email. Responda somente JSON valido, sem markdown, sem texto antes e sem texto depois.",
          "maxIterations": 3
        }
      },
