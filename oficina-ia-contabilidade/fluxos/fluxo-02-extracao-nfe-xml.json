    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Leia a NF-e abaixo em XML e extraia exatamente este JSON: {\"fornecedor\":\"\",\"cnpj\":\"\",\"valor_total\":\"\",\"competencia\":\"\",\"categoria\":\"\"}. Regras: fornecedor vem de emit/xNome; cnpj vem de emit/CNPJ; valor_total vem de total/ICMSTot/vNF; competencia deve ser AAAA-MM com base em ide/dhEmi; categoria deve ser curta, como material_consumo, servicos_tomados ou mercadorias, olhando natOp e xProd. Responda somente JSON valido. Arquivo: ' + ($json.body?.arquivo || 'xml-informado-no-webhook') + '. XML: ' + ($json.body?.xml || '') }}",
        "options": {
          "systemMessage": "Voce e um assistente de escritorio contabil. Extraia dados de NF-e a partir do XML informado no webhook. Responda somente JSON valido, sem markdown, sem texto antes e sem texto depois.",
          "maxIterations": 3
        }
      },
